# DIPLOMAT — Environment Configuration
# Copy this file to .env and fill in your values.

# Required for live LLM mode (get from https://aistudio.google.com)
GOOGLE_API_KEY=your-api-key-here

# Confirmed working model on the free tier
# Do NOT use: gemini-1.5-flash, gemini-2.5-flash, gemini-3.6-flash
# (those either 404 on new accounts or hit tiny 20 req/day quota caps)
GEMINI_MODEL=gemini-3.5-flash-lite

# Set to false to use real Gemini API. true = deterministic mock mode (no API key needed)
MOCK_MODE=true
